//! {{Subsystem Name}} abstract model.
//!
//! This file is part of the spec. It is included by the `model` crate as
//! `model::{{tag}}` and is the single source of truth for this subsystem's state,
//! invariants, and contracts. Implementation crates provide `abs()` from their
//! concrete state to [`State`] and verify every property against it.
//!
//! Rules: `no_std`, no `unsafe`, no heap, no dependencies beyond `core` and
//! `crate::platform`. Capacity is a const generic so harnesses can shrink it.

use crate::platform::*;

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------

/// {{One sentence: what the state is, mathematically.}}
///
/// `N` is the capacity. Harness N = {{4}}, deployed N = {{4096}}.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct State<const N: usize> {
    /// {{field meaning}}
    pub entries: [Option<Entry>; N],
}

/// {{One entry in the state.}}
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Entry {
    // {{fields}}
}

impl<const N: usize> State<N> {
    /// The empty state. Must satisfy [`inv`].
    pub const fn empty() -> Self {
        Self { entries: [None; N] }
    }

    /// Number of live entries.
    pub fn len(&self) -> usize {
        let mut n = 0;
        let mut i = 0;
        while i < N {
            if self.entries[i].is_some() {
                n += 1;
            }
            i += 1;
        }
        n
    }
}

